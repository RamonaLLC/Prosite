rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All Catch-All (Pillar 1 & 4)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidJob(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.status is string && (data.status == 'planning' || data.status == 'in-progress' || data.status == 'completed');
    }

    function isValidWorker(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.senderId is string && data.senderId.size() <= 128 &&
             data.text is string && data.text.size() <= 2000;
    }

    function isValidTimeLog(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.workerId is string && data.workerId.size() <= 128 &&
             data.jobId is string && data.jobId.size() <= 128;
    }

    function isValidCompanySettings(data) {
      return data.companyName is string && data.companyName.size() <= 150 &&
             data.email is string && data.email.size() <= 100;
    }

    function isValidTransaction(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.type is string && data.amount is number &&
             data.status is string;
    }

    function isValidSubscription(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.companyId is string && data.companyId.size() <= 128 &&
             data.plan is string && data.amount is number &&
             data.status is string;
    }

    // Diagnostic & Connection Check endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isValidId(jobId) && isValidJob(incoming());
      allow update: if isValidId(jobId) && isValidJob(incoming());
      allow delete: if isValidId(jobId);
    }

    // Workers collection
    match /workers/{workerId} {
      allow read: if true;
      allow create: if isValidId(workerId) && isValidWorker(incoming());
      allow update: if isValidId(workerId) && isValidWorker(incoming());
      allow delete: if isValidId(workerId);
    }

    // Messages collection
    match /messages/{messageId} {
      allow read: if true;
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow update: if isValidId(messageId) && isValidMessage(incoming());
      allow delete: if isValidId(messageId);
    }

    // Geofence Time Logs collection
    match /timeLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && isValidTimeLog(incoming());
      allow update: if isValidId(logId) && isValidTimeLog(incoming());
      allow delete: if isValidId(logId);
    }

    // Company Settings collection
    match /companySettings/{companyId} {
      allow read: if true;
      allow create: if isValidId(companyId) && isValidCompanySettings(incoming());
      allow update: if isValidId(companyId) && isValidCompanySettings(incoming());
      allow delete: if isValidId(companyId);
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read: if true;
      allow create: if isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if isValidId(transactionId) && isValidTransaction(incoming());
      allow delete: if isValidId(transactionId);
    }

    // Subscriptions collection
    match /subscriptions/{subscriptionId} {
      allow read: if true;
      allow create: if isValidId(subscriptionId) && isValidSubscription(incoming());
      allow update: if isValidId(subscriptionId) && isValidSubscription(incoming());
      allow delete: if isValidId(subscriptionId);
    }
  }
}
